# ===============================================================
# THÔNG TIN TÀI KHOẢN MẪU HỆ THỐNG GỌN PHÒNG (DO-AN-20)
# ===============================================================

# 1. Tài khoản Quản trị viên (Admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123
ADMIN_ROLE=ADMIN
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=admin@doan20.local

# 2. Tài khoản Người dùng mẫu (Sample User)
USER_USERNAME=user
USER_PASSWORD=123456
USER_ROLE=USER
USER_NAME=Nguyễn Văn Nam
USER_ROOM=Phòng 302 • Căn hộ Harmony
USER_EMAIL=user@doan20.local

# 3. Cấu hình MQTT Broker (HiveMQ Cloud / Public Broker)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=doan20/

# 4. Cấu hình Firebase
FIREBASE_COLLECTION_USERS=users
FIREBASE_COLLECTION_ITEMS=items
