<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_login">

    <!-- Login Screen -->
    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.doan20.ui.auth.LoginFragment"
        android:label="Đăng nhập"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_admin"
            app:destination="@id/nav_admin"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/nav_register" />
    </fragment>

    <!-- Register Screen -->
    <fragment
        android:id="@+id/nav_register"
        android:name="com.example.doan20.ui.auth.RegisterFragment"
        android:label="Đăng ký"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Main Screen with ViewPager2 Tabs (Trang chủ, Vật dụng, Thống kê, Cá nhân) -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.doan20.ui.main.MainFragment"
        android:label="Trang chính"
        tools:layout="@layout/fragment_main" />

    <!-- Filter Screen (Figma 09_Filter) -->
    <fragment
        android:id="@+id/nav_filter"
        android:name="com.example.doan20.ui.items.FilterFragment"
        android:label="Bộ lọc"
        tools:layout="@layout/fragment_filter" />

    <!-- Detail Screen (Figma 03_ItemDetail & Admin Chi tiết thiết bị) -->
    <fragment
        android:id="@+id/nav_detail"
        android:name="com.example.doan20.ui.detail.ItemDetailFragment"
        android:label="Chi tiết vật dụng"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="itemId"
            app:argType="string" />
        <argument
            android:name="userId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="ownerName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="ownerEmail"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/nav_add_item" />
    </fragment>

    <!-- Add & Edit Item Screen -->
    <fragment
        android:id="@+id/nav_add_item"
        android:name="com.example.doan20.ui.additem.AddItemFragment"
        android:label="Thêm vật dụng"
        tools:layout="@layout/fragment_add_item">
        <argument
            android:name="itemId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Admin Screen -->
    <fragment
        android:id="@+id/nav_admin"
        android:name="com.example.doan20.ui.admin.AdminFragment"
        android:label="Quản trị"
        tools:layout="@layout/fragment_admin">
        <action
            android:id="@+id/action_admin_to_detail"
            app:destination="@id/nav_detail" />
    </fragment>

</navigation>
