<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- Home Tab -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.doan20.ui.home.HomeFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_items"
            app:destination="@id/nav_items" />
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/nav_detail" />
        <action
            android:id="@+id/action_home_to_add"
            app:destination="@id/nav_add_item" />
    </fragment>

    <!-- Items Tab -->
    <fragment
        android:id="@+id/nav_items"
        android:name="com.example.doan20.ui.items.ItemsFragment"
        android:label="Vật dụng"
        tools:layout="@layout/fragment_items">
        <action
            android:id="@+id/action_items_to_detail"
            app:destination="@id/nav_detail" />
        <action
            android:id="@+id/action_items_to_add"
            app:destination="@id/nav_add_item" />
    </fragment>

    <!-- Statistics Tab -->
    <fragment
        android:id="@+id/nav_statistics"
        android:name="com.example.doan20.ui.statistics.StatisticsFragment"
        android:label="Thống kê"
        tools:layout="@layout/fragment_statistics" />

    <!-- Profile Tab -->
    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.doan20.ui.profile.ProfileFragment"
        android:label="Cá nhân"
        tools:layout="@layout/fragment_profile" />

    <!-- Detail Screen -->
    <fragment
        android:id="@+id/nav_detail"
        android:name="com.example.doan20.ui.detail.ItemDetailFragment"
        android:label="Chi tiết vật dụng"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="itemId"
            app:argType="string" />
    </fragment>

    <!-- Add Item Screen -->
    <fragment
        android:id="@+id/nav_add_item"
        android:name="com.example.doan20.ui.additem.AddItemFragment"
        android:label="Thêm vật dụng"
        tools:layout="@layout/fragment_add_item" />

</navigation>
